<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Settings Window -->
    <sys:String x:Key="Settings.Title">⚙️  NotifyLite 设置</sys:String>
    <sys:String x:Key="Settings.Language.Header">🌐  显示语言</sys:String>
    <sys:String x:Key="Settings.Language.Label">显示语言</sys:String>
    <sys:String x:Key="Settings.Language.System">跟随系统</sys:String>
    <sys:String x:Key="Settings.Language.Chinese">简体中文</sys:String>
    <sys:String x:Key="Settings.Language.English">English</sys:String>

    <sys:String x:Key="Settings.FloatingIcon.Header">🫧  浮动图标</sys:String>
    <sys:String x:Key="Settings.FloatingIcon.Show">在屏幕上显示浮动图标</sys:String>
    <sys:String x:Key="Settings.FloatingIcon.Description">可拖动的图标，显示通知数量。点击可查看通知历史。</sys:String>

    <sys:String x:Key="Settings.Appearance.Header">🎨  外观</sys:String>
    <sys:String x:Key="Settings.Appearance.Theme">主题</sys:String>
    <sys:String x:Key="Settings.Appearance.ThemeDark">深色</sys:String>
    <sys:String x:Key="Settings.Appearance.ThemeLight">浅色</sys:String>
    <sys:String x:Key="Settings.Appearance.Font">字体</sys:String>
    <sys:String x:Key="Settings.Appearance.TitleSize">标题字号</sys:String>
    <sys:String x:Key="Settings.Appearance.BodySize">正文字号</sys:String>

    <sys:String x:Key="Settings.Colors.Header">🎯  颜色</sys:String>
    <sys:String x:Key="Settings.Colors.TitleText">标题文字</sys:String>
    <sys:String x:Key="Settings.Colors.BodyText">正文文字</sys:String>
    <sys:String x:Key="Settings.Colors.CardBackground">卡片背景</sys:String>
    <sys:String x:Key="Settings.Colors.Accent">强调色 (倒计时条)</sys:String>

    <sys:String x:Key="Settings.Card.Header">📐  卡片</sys:String>
    <sys:String x:Key="Settings.Card.Width">宽度</sys:String>
    <sys:String x:Key="Settings.Card.CornerRadius">圆角半径</sys:String>
    <sys:String x:Key="Settings.Card.CardOpacity">卡片不透明度</sys:String>
    <sys:String x:Key="Settings.Card.TextOpacity">文字不透明度</sys:String>

    <sys:String x:Key="Settings.Behavior.Header">⏱️  行为</sys:String>
    <sys:String x:Key="Settings.Behavior.AutoDismiss">自动消除</sys:String>
    <sys:String x:Key="Settings.Behavior.MaxToasts">最大并发显示数量</sys:String>
    <sys:String x:Key="Settings.Behavior.Position">显示位置</sys:String>
    <sys:String x:Key="Settings.Behavior.PositionBottomRight">右下角</sys:String>
    <sys:String x:Key="Settings.Behavior.PositionBottomLeft">左下角</sys:String>
    <sys:String x:Key="Settings.Behavior.PositionTopRight">右上角</sys:String>
    <sys:String x:Key="Settings.Behavior.PositionTopLeft">左上角</sys:String>
    <sys:String x:Key="Settings.Behavior.PositionStickToIcon">吸附在图标旁</sys:String>
    <sys:String x:Key="Settings.Behavior.PositionCustom">自定义坐标</sys:String>
    <sys:String x:Key="Settings.Behavior.PosX">X 坐标</sys:String>
    <sys:String x:Key="Settings.Behavior.PosY">Y 坐标</sys:String>
    <sys:String x:Key="Settings.Behavior.PosTip">提示：最小 0。最大 X：{0}，最大 Y：{1}</sys:String>

    <sys:String x:Key="Settings.Sound.Header">🔔  提示音</sys:String>
    <sys:String x:Key="Settings.Sound.NotificationSound">通知提示音</sys:String>
    <sys:String x:Key="Settings.Sound.DefaultSound">默认提示音</sys:String>
    <sys:String x:Key="Settings.Sound.SystemDefault">系统默认</sys:String>
    <sys:String x:Key="Settings.Sound.Custom">自定义</sys:String>
    <sys:String x:Key="Settings.Sound.Browse">浏览...</sys:String>
    <sys:String x:Key="Settings.Sound.AppOverrides">各应用独立提示音设置</sys:String>
    <sys:String x:Key="Settings.Sound.NoApps">尚未检测到应用。收到新通知后，应用将自动显示在此处。</sys:String>
    <sys:String x:Key="Settings.Sound.ModeDefault">默认</sys:String>
    <sys:String x:Key="Settings.Sound.ModeCustom">自定义</sys:String>
    <sys:String x:Key="Settings.Sound.ModeMuted">静音</sys:String>
    <sys:String x:Key="Settings.Sound.BrowseDialogTitle">选择通知提示音</sys:String>
    <sys:String x:Key="Settings.Sound.AppSoundDialogTitle">选择应用提示音</sys:String>
    <sys:String x:Key="Settings.Sound.Filter">音频文件|*.wav|所有文件|*.*</sys:String>

    <sys:String x:Key="Settings.ResetDefaults">恢复默认</sys:String>
    <sys:String x:Key="Settings.ResetConfirm.Title">恢复默认</sys:String>
    <sys:String x:Key="Settings.ResetConfirm.Message">确定将所有设置恢复为默认值吗？</sys:String>
    <sys:String x:Key="Settings.Cancel">取消</sys:String>
    <sys:String x:Key="Settings.Save">保存</sys:String>
    <sys:String x:Key="Settings.Saved">已保存 ✔</sys:String>

    <!-- Tray -->
    <sys:String x:Key="Tray.Title">NotifyLite — 自定义通知</sys:String>
    <sys:String x:Key="Tray.Active">运行中 - 正在监听</sys:String>
    <sys:String x:Key="Tray.Disabled">已禁用</sys:String>
    <sys:String x:Key="Tray.PermissionRequired">需要通知权限</sys:String>
    <sys:String x:Key="Tray.TooltipFormat">NotifyLite — {0}</sys:String>
    <sys:String x:Key="Tray.Menu.Enabled">✅ 已启用</sys:String>
    <sys:String x:Key="Tray.Menu.Disabled">⬜ 已禁用</sys:String>
    <sys:String x:Key="Tray.Menu.DarkTheme">🌙 深色模式</sys:String>
    <sys:String x:Key="Tray.Menu.LightTheme">☀️ 浅色模式</sys:String>
    <sys:String x:Key="Tray.Menu.SoundOn">🔔 提示音: 开启</sys:String>
    <sys:String x:Key="Tray.Menu.SoundOff">🔕 提示音: 关闭</sys:String>
    <sys:String x:Key="Tray.Menu.AutoStartOn">🔄 开机自启: 开启</sys:String>
    <sys:String x:Key="Tray.Menu.AutoStartOff">🔄 开机自启: 关闭</sys:String>
    <sys:String x:Key="Tray.Menu.Settings">⚙️ 设置</sys:String>
    <sys:String x:Key="Tray.Menu.Exit">❌ 退出</sys:String>

    <!-- Permission -->
    <sys:String x:Key="Permission.Title">NotifyLite - 需要权限</sys:String>
    <sys:String x:Key="Permission.Message">NotifyLite 需要访问您的通知权限。&#x0a;&#x0a;请在 Windows 设置中授予通知访问权限：&#x0a;设置 &gt; 隐私 &gt; 通知</sys:String>

    <!-- Toast, History, Floating Icon -->
    <sys:String x:Key="Toast.Title">NotifyLite Toast</sys:String>
    <sys:String x:Key="Toast.Close">关闭</sys:String>
    <sys:String x:Key="Toast.UnknownApp">未知应用</sys:String>
    <sys:String x:Key="Time.JustNow">刚刚</sys:String>
    <sys:String x:Key="Time.SecondsAgo">{0} 秒前</sys:String>
    <sys:String x:Key="Time.MinutesAgo">{0} 分钟前</sys:String>
    <sys:String x:Key="Time.HoursAgo">{0} 小时前</sys:String>
    <sys:String x:Key="History.Title">通知历史</sys:String>
    <sys:String x:Key="History.ClearAll">清空全部</sys:String>
    <sys:String x:Key="History.Empty">暂无通知</sys:String>
    <sys:String x:Key="History.UnknownApp">未知应用</sys:String>
    <sys:String x:Key="History.Dismiss">移除</sys:String>
    <sys:String x:Key="FloatingIcon.Title">NotifyLite</sys:String>
    <sys:String x:Key="FloatingIcon.Tooltip">NotifyLite — 点击查看通知历史</sys:String>

</ResourceDictionary>
